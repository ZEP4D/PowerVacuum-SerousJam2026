  m_Script: {fileID: 11500000, guid: 18a729f3a4a94b96ae67e2f5a7e96471, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Decision
  stampState: 0
  description: Dear Minister,<br><br>We were contacted by the management team of
    the famous Rockstar from ASU (Arosa State United).<br><br>They would like to
    hold their next concert in our capitol. This will require a lot more energy than
